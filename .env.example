DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.padlupp.com,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://app.padlupp.com,https://padlupp.com,https://www.padlupp.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.padlupp.com
# Local development defaults to SQLite.
DATABASE_ENGINE=sqlite
DATABASE_PATH=/var/lib/padlupp/db.sqlite3

# Production PostgreSQL settings. Set DATABASE_ENGINE=postgresql to use these.
POSTGRES_DB=padlupp
POSTGRES_USER=padlupp_app
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DATABASE_CONN_MAX_AGE=60
MEDIA_ROOT=/var/lib/padlupp/assets
PUBLIC_BASE_URL=https://api.padlupp.com
CRON_SHARED_SECRET=replace-with-a-long-random-value
MESSAGE_RECALL_WINDOW_MINUTES=15
CHECKIN_EVIDENCE_RETENTION_DAYS=30

# Optional integrations
REDIS_URL=
EMAIL_NOTIFICATIONS_ENABLED=0
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Mobile push notifications (Firebase Cloud Messaging HTTP v1)
FIREBASE_PUSH_ENABLED=0
FIREBASE_PROJECT_ID=
# Store this JSON file outside the repository and restrict it to the service user.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Alternative for secret managers; prefer the file setting on a server.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH2_CLIENT_ID=
# Optional comma-separated additional audiences for other trusted clients.
GOOGLE_OAUTH2_CLIENT_IDS=674368689981-4lo3fedmr76gqrfftka13vm29htlq1kg.apps.googleusercontent.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
